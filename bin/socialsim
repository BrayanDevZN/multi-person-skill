#!/usr/bin/env bash
# Wrapper: bootstraps the local venv on first run, then runs the socialsim CLI.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VENV="$ROOT/.venv"
MARKER="$VENV/.socialsim-installed"

if [ ! -x "$VENV/bin/python" ]; then
  echo "[socialsim] creating virtualenv at $VENV" >&2
  python3 -m venv "$VENV" || { echo "[socialsim] ERROR: could not create venv (is python3-venv installed?)" >&2; exit 1; }
fi

if [ ! -f "$MARKER" ] || [ "$ROOT/pyproject.toml" -nt "$MARKER" ]; then
  echo "[socialsim] installing dependencies" >&2
  "$VENV/bin/python" -m pip install -q -e "$ROOT" >&2 \
    || { echo "[socialsim] ERROR: dependency install failed (network access needed). Retry, or run: $VENV/bin/pip install -e $ROOT" >&2; exit 1; }
  touch "$MARKER"
fi

exec "$VENV/bin/python" -m socialsim "$@"
